# ========================================
# Hub API Server - Environment Variables
# ========================================
# cp .env.example .env

# ========================================
# Supabase Configuration
# ========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================
# Database Configuration
# ========================================
# --- H2 (Dev) ---
DATABASE_URL=jdbc:h2:file:./data/hub
DATABASE_DRIVER=org.h2.Driver
DATABASE_USER=sa
DATABASE_PASSWORD=

# --- PostgreSQL (Prod) ---
#DATABASE_URL=jdbc:postgresql://localhost:5432/hub
#DATABASE_DRIVER=org.postgresql.Driver
#DATABASE_USER=hub
#DATABASE_PASSWORD=your-secure-password

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=your-strong-secret-key-here

# ========================================
# Email Configuration (Brevo API)
# ========================================
# Brevo API Key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=your-name
BASE_URL=http://localhost:8080

# ========================================
# Delivery API (택배 추적)
# ========================================
DELIVERY_API_BASE_URL=https://api.deliveryapi.co.kr
DELIVERY_API_KEY=your-delivery-api-public-key
DELIVERY_API_SECRET_KEY=your-delivery-api-secret-key
DELIVERY_WEBHOOK_ENDPOINT_ID=your-webhook-endpoint-id
DELIVERY_WEBHOOK_SECRET=your-webhook-secret

# ========================================
# Toss Payments (결제)
# ========================================
TOSS_SECRET_KEY=your-toss-test-secret-key
TOSS_API_BASE_URL=https://api.tosspayments.com

# ========================================
# Firebase (FCM Push Notifications)
# ========================================
FIREBASE_SERVICE_ACCOUNT_KEY=./your-service-accountKey.json

# ========================================
# Google Sign-In (간편로그인)
# ========================================
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ========================================
# Kakao Login (간편로그인)
# ========================================
KAKAO_APP_ID=your-kakao-app-id

# ========================================
# CORS Configuration
# ========================================
ALLOWED_HOSTS=localhost:3000,localhost:3001

# ========================================
# Server Configuration
# ========================================
PORT=8080
ENVIRONMENT=dev
